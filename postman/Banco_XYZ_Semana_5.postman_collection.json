      "name": "Core Banking",
      "item": [
        {
          "name": "Estado del core",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{coreUrl}}/api/estado",
              "host": [
                "{{coreUrl}}"
              ],
              "path": [
                "api",
                "estado"
              ]
            }
          }
        },
        {
          "name": "Resumen de cuenta",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{coreUrl}}/api/cuentas/{{accountId}}/resumen",
              "host": [
                "{{coreUrl}}"
              ],
              "path": [
