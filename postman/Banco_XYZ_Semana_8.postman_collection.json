            "atm",
            "cuentas",
            "{{accountId}}",
            "retiros"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Retiro ATM responde 202 Accepted', function () {",
              "  pm.response.to.have.status(202);",
              "});",
              "pm.test('Retiro inicia en PENDING y guarda transactionId', function () {",
              "  const json = pm.response.json();",
              "  pm.expect(json.status).to.eql('PENDING');",
              "  pm.expect(json.transactionId).to.be.a('string').and.not.empty;",
              "  pm.collectionVariables.set('transactionId', json.transactionId);",
              "  pm.collectionVariables.set('confirmPollCount', '0');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "08 - Consultar retiro hasta confirmar",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": {
          "raw": "{{gatewayBaseUrl}}/gateway/atm/transacciones/{{transactionId}}",
          "host": [
            "{{gatewayBaseUrl}}"
          ],
          "path": [
            "gateway",
            "atm",
            "transacciones",
            "{{transactionId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Consulta de transaccion responde 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "const json = pm.response.json();",
              "const count = Number(pm.collectionVariables.get('confirmPollCount') || '0');",
              "if (json.status !== 'CONFIRMED' && count < 8) {",
              "  pm.collectionVariables.set('confirmPollCount', String(count + 1));",
              "  pm.test('Esperando confirmacion asincrona', function (done) {",
              "    setTimeout(function () {",
              "      pm.expect(json.status).to.be.oneOf(['PENDING', 'CONFIRMED']);",
              "      done();",
              "    }, 1000);",
              "  });",
              "  postman.setNextRequest('08 - Consultar retiro hasta confirmar');",
              "} else {",
              "  pm.test('Retiro confirmado por saga Kafka', function () {",
              "    pm.expect(json.status).to.eql('CONFIRMED');",
              "    pm.expect(json.authorizationCode).to.be.a('string').and.not.empty;",
              "  });",
              "}"
            ]
          }
        }
      ]
    },
