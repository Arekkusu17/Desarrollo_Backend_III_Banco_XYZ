            "value": "application/x-www-form-urlencoded"
          }
        ],
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "grant_type",
              "value": "client_credentials",
              "type": "text"
            },
            {
              "key": "scope",
              "value": "web.read mobile.read atm.read atm.write risk.read account.read payment.read payment.write customer.read customer.write",
              "type": "text"
